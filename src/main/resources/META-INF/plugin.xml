<idea-plugin>
  <id>io.github.haasfynn.wardennavy</id>
  <name>Warden Navy</name>
  <category>UI</category>
  <vendor url="https://github.com/HaasFynn">HaasFynn</vendor>

  <description><![CDATA[
    <p>Two dark naval themes inspired by the Warden navy of the game Foxhole.</p>
    <ul>
      <li><b>Warden Navy Blacksteele</b>: gunmetal hull, wooden deck and banner blue.</li>
      <li><b>Warden Navy Nakki</b>: deep water, sonar green and periscope glass.</li>
    </ul>
    <p>Each theme ships a matching editor colour scheme, background artwork, icons and a naval progress bar.</p>
    <p>Fan-made. Not affiliated with or endorsed by Siege Camp.</p>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="io.github.haasfynn.wardennavy.blacksteele" path="/themes/Blacksteele.theme.json" targetUi="islands"/>
    <themeProvider id="io.github.haasfynn.wardennavy.nakki" path="/themes/Nakki.theme.json" targetUi="islands"/>
    <applicationConfigurable parentId="appearance" id="io.github.haasfynn.wardennavy.settings"
                             instance="io.github.haasfynn.wardennavy.settings.WardenNavyConfigurable"
                             displayName="Warden Navy"/>
    <statusBarWidgetFactory id="WardenNavyDepthGauge"
                            implementation="io.github.haasfynn.wardennavy.instruments.DepthGaugeWidgetFactory"
                            order="after positionWidget"/>
  </extensions>

  <applicationListeners>
    <listener class="io.github.haasfynn.wardennavy.WardenNavyListener"
              topic="com.intellij.ide.ui.LafManagerListener"/>
    <listener class="io.github.haasfynn.wardennavy.WardenNavyListener"
              topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="io.github.haasfynn.wardennavy.WardenNavyListener"
              topic="com.intellij.ide.PowerSaveMode$Listener"/>
    <listener class="io.github.haasfynn.wardennavy.WardenNavyPluginListener"
              topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <listener class="io.github.haasfynn.wardennavy.effects.EditorEffects"
              topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
  </applicationListeners>

  <projectListeners>
    <listener class="io.github.haasfynn.wardennavy.effects.BuildFinishListener"
              topic="com.intellij.task.ProjectTaskListener"/>
    <listener class="io.github.haasfynn.wardennavy.effects.RunFinishListener"
              topic="com.intellij.execution.ExecutionListener"/>
  </projectListeners>
</idea-plugin>
